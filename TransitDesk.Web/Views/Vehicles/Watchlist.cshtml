@model List<WatchedVehicle>
@{
    ViewData["Title"] = "Monitorowane pojazdy";
}

<partial name="_SuccessAlert" />

<h1 class="h2">@ViewData["Title"]</h1>
<p class="text-muted">Lista jest przechowywana w sesji (wygasa po 15 minutach bezczynności) i nie jest zapisywana trwale.</p>

@if (Model.Count == 0)
{
    <p>Nie monitorujesz jeszcze żadnych pojazdów. Dodaj je z poziomu <a asp-action="Index">ewidencji floty</a>.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Nr boczny</th><th>Model</th><th>Zajezdnia</th><th>Dodano (UTC)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-sideNumber="@item.SideNumber">#@item.SideNumber</a></td>
                    <td>@item.ModelName</td>
                    <td>@item.DepotName</td>
                    <td>@item.AddedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form asp-action="RemoveVehicleFromWatchlist" method="post">
                            <input type="hidden" name="sideNumber" value="@item.SideNumber" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
