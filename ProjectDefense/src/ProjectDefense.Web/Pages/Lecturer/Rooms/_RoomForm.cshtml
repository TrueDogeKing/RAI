@model Room

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="RoomNumber" class="form-label"></label>
    <input asp-for="RoomNumber" class="form-control" />
    <span asp-validation-for="RoomNumber" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="WorkstationsCount" class="form-label"></label>
    <input asp-for="WorkstationsCount" class="form-control" />
    <span asp-validation-for="WorkstationsCount" class="text-danger"></span>
</div>
