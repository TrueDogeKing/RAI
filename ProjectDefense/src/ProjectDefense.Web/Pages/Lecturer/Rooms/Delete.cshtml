@page "{id:int}"
@model ProjectDefense.Web.Pages.Lecturer.Rooms.DeleteModel
@{
    ViewData["Title"] = L["DeleteRoom"];
}

<h1>@L["DeleteRoom"]</h1>

@if (Model.HasAvailabilities)
{
    <div class="alert alert-warning">@L["RoomHasAvailabilities"]</div>
}
else
{
    <p>@L["DeleteRoomConfirm"]</p>
}

<dl class="row">
    <dt class="col-sm-3">@L["RoomNumber"]</dt>
    <dd class="col-sm-9">@Model.Room.RoomNumber</dd>
    <dt class="col-sm-3">@L["RoomName"]</dt>
    <dd class="col-sm-9">@Model.Room.Name</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger" disabled="@Model.HasAvailabilities">@L["Delete"]</button>
    <a class="btn btn-link" asp-page="Index">@L["BackToList"]</a>
</form>
