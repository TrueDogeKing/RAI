@page
@model ProjectDefense.Web.Pages.Lecturer.Availability.CreateModel
@{
    ViewData["Title"] = L["GenerateSlots"];
}

<h1>@L["GenerateSlots"]</h1>
<p class="text-muted">@L["GenerateSlotsHelp"]</p>

<div class="row">
    <div class="col-lg-7">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.RoomId" class="form-label"></label>
                <select asp-for="Input.RoomId" asp-items="Model.RoomList" class="form-select">
                    <option value="">@L["SelectRoom"]</option>
                </select>
                <span asp-validation-for="Input.RoomId" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.StartDate" class="form-label"></label>
                    <input asp-for="Input.StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.EndDate" class="form-label"></label>
                    <input asp-for="Input.EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.DailyStartTime" class="form-label"></label>
                    <input asp-for="Input.DailyStartTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="Input.DailyStartTime" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.DailyEndTime" class="form-label"></label>
                    <input asp-for="Input.DailyEndTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="Input.DailyEndTime" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.SlotDurationMinutes" class="form-label"></label>
                    <input asp-for="Input.SlotDurationMinutes" class="form-control" />
                    <span asp-validation-for="Input.SlotDurationMinutes" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">@L["Generate"]</button>
            <a class="btn btn-link" asp-page="Index">@L["BackToList"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
