@page
@model ProjectDefense.Web.Pages.Lecturer.Export.IndexModel
@{
    ViewData["Title"] = L["Export"];
}

<h1>@L["Export"]</h1>
<p class="text-muted">@L["ExportHelp"]</p>

<div class="row">
    <div class="col-lg-7">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.RoomId" class="form-label"></label>
                <select asp-for="Input.RoomId" asp-items="Model.RoomList" class="form-select">
                    <option value="">@L["All"]</option>
                </select>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.From" class="form-label"></label>
                    <input asp-for="Input.From" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.To" class="form-label"></label>
                    <input asp-for="Input.To" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                    <span asp-validation-for="Input.To" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.OnlyBooked" class="form-check-label">
                    <input asp-for="Input.OnlyBooked" class="form-check-input" /> @L["OnlyBooked"]
                </label>
            </div>
            <div class="mb-3">
                <span class="form-label d-block">@L["Format"]</span>
                @foreach (var format in Enum.GetValues<ExportFormat>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Input.Format" value="@format" id="format-@format" />
                        <label class="form-check-label" for="format-@format">.@format.ToString().ToLowerInvariant()</label>
                    </div>
                }
            </div>
            <button type="submit" class="btn btn-primary">@L["Download"]</button>
        </form>
    </div>
</div>
