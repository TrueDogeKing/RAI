@using System.Globalization
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isLecturer = User.IsInRole(Roles.Lecturer);
    var isStudent = User.IsInRole(Roles.Student);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectDefense</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">ProjectDefense</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (isLecturer)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Rooms/Index">@L["Rooms"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Availability/Index">@L["Availability"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Reservations/Index">@L["Reservations"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Block/Index">@L["BlockPeriod"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Students/Index">@L["Students"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Lecturer/Export/Index">@L["Export"]</a></li>
                        }
                        @if (isStudent)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Student/Index">@L["MyReservation"]</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" href="/swagger">API</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <div class="btn-group btn-group-sm" role="group" aria-label="@L["Language"]">
                            @foreach (var culture in ProjectDefense.Web.Infrastructure.CultureEndpoints.SupportedCultures)
                            {
                                var active = culture == currentCulture ? "btn-light" : "btn-outline-light";
                                <a class="btn @active" href="@($"/culture/{culture}?returnUrl={Uri.EscapeDataString(returnUrl)}")">@(culture[..2].ToUpperInvariant())</a>
                            }
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            <partial name="_StatusMessages" />
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted py-3">
        <div class="container">ProjectDefense &middot; @L["FooterNote"]</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
