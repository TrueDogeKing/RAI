@page
@model ProjectDefense.Web.Pages.Student.IndexModel
@{
    ViewData["Title"] = L["MyReservation"];
}

<h1 class="mb-3">@L["MyReservation"]</h1>

@if (Model.IsBanned)
{
    <div class="alert alert-danger">@L["StudentBanned"]</div>
}

@if (Model.Active is not null)
{
    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">@L["YourReservation"]</div>
                <div class="fs-5">@Model.ActiveLabel</div>
            </div>
            <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Active.Id">
                <button type="submit" class="btn btn-outline-danger">@L["CancelReservation"]</button>
            </form>
        </div>
    </div>
}
else
{
    <p class="lead">@L["NoActiveReservation"]</p>
}

<h2 class="h4">@L["AvailableSlots"]</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label" for="RoomId">@L["Room"]</label>
        <select id="RoomId" name="RoomId" asp-items="Model.RoomList" class="form-select">
            <option value="">@L["All"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">@L["Filter"]</button>
    </div>
</form>

@if (Model.Slots.Count == 0)
{
    <div class="alert alert-secondary">@L["NoFreeSlots"]</div>
}
else
{
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>@L["Slot"]</th>
                <th>@L["Lecturer"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in Model.Slots)
            {
                <tr>
                    <td>@slot.Label</td>
                    <td>@slot.LecturerName</td>
                    <td class="text-end">
                        @if (!Model.IsBanned)
                        {
                            if (Model.Active is null)
                            {
                                <form method="post" asp-page-handler="Book" asp-route-id="@slot.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-primary">@L["Book"]</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reschedule" asp-route-id="@slot.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@L["Reschedule"]</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
