@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = L["ResendConfirmationTitle"];
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form method="post">
            <p class="text-muted">@L["ResendConfirmationIntro"]</p>
            @* Identity zgłasza tu powodzenie jako błąd modelu („Verification email sent…”), więc kolor ustalamy osobno. *@
            @if (ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry.Errors.Count > 0)
            {
                <div class="alert alert-info" role="status">@L.Translate(entry.Errors[0].ErrorMessage)</div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Resend"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
