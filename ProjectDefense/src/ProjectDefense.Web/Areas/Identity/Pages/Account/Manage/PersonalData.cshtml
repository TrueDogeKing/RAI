@page
@model PersonalDataModel
@{
    ViewData["Title"] = L["PersonalData"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h4">@ViewData["Title"]</h2>
<div class="row">
    <div class="col-lg-8">
        <p>@L["PersonalDataText"]</p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="d-inline">
            <button class="btn btn-primary" type="submit">@L["DownloadPersonalData"]</button>
        </form>
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger ms-2">@L["DeleteAccount"]</a>
    </div>
</div>
