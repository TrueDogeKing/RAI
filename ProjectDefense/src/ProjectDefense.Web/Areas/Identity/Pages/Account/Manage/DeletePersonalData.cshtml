@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = L["DeleteAccount"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h4">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    <strong>@L["DeleteAccountWarning"]</strong>
</div>
<div class="row">
    <div class="col-lg-8">
        <form id="delete-user" method="post">
            <partial name="_IdentityErrors" />
            @if (Model.RequirePassword)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }
            <button class="w-100 btn btn-lg btn-danger" type="submit">@L["DeleteAccountConfirm"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
