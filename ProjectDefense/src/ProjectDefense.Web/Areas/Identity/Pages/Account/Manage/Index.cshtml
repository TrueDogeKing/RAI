@page
@model IndexModel
@{
    ViewData["Title"] = L["Profile"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h4">@ViewData["Title"]</h2>
<partial name="_IdentityStatus" model="Model.StatusMessage" />
<div class="row">
    <div class="col-lg-8">
        <form id="profile-form" method="post">
            <partial name="_IdentityErrors" />
            <div class="form-floating mb-3">
                <input id="username" value="@Model.Username" class="form-control" placeholder="username" disabled />
                <label for="username">@L["Username"]</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+48 000 000 000" />
                <label asp-for="Input.PhoneNumber"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">@L["Save"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
