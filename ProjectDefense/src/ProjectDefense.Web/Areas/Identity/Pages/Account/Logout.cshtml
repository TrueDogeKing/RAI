@page
@model LogoutModel
@{
    ViewData["Title"] = L["Logout"];
}

<h1>@ViewData["Title"]</h1>
@if (User.Identity?.IsAuthenticated ?? false)
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
        <button type="submit" class="btn btn-primary">@L["Logout"]</button>
    </form>
}
else
{
    <p>@L["LoggedOutText"]</p>
    <p><a asp-page="./Login">@L["ClickToLogin"]</a></p>
}
